# Server
# In production (NODE_ENV=production) the app refuses to start unless all of
# these are set: SESSION_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# SMTP_HOST, SMTP_USER, SMTP_PASS, BASE_URL, EMAIL_FROM.
PORT=3000
# BASE_URL is REQUIRED — it builds the Stripe checkout success/cancel URLs.
BASE_URL=https://yourdomain.com

# Sentry error tracking (optional — get DSN from sentry.io)
SENTRY_DSN=

# Stripe — get these from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP — works with Gmail app passwords, Postmark, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Who emails come from and where operator notifications go
# EMAIL_FROM is REQUIRED — it's the From address on all transactional mail.
EMAIL_FROM="Letterhome <hello@yourdomain.com>"
# Override the From address for system emails (defaults to EMAIL_FROM if unset)
SMTP_FROM=
OPERATOR_EMAIL=support@letterhome.ca
# Error alerts — defaults to SMTP_USER if not set
ADMIN_EMAIL=support@letterhome.ca

# Admin panel — run: node scripts/create-admin.js  to generate these
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Admin 2FA — base32 secret used by the TOTP authenticator app (Google Authenticator, 1Password, etc.).
# Optional. If set, the admin login page asks for a 6-digit code after username/password.
# Generate one with: node scripts/create-admin.js (or any base32-secret tool).
TOTP_SECRET=

# Backups
# BACKUP_PASSPHRASE: if set, every backup file is encrypted with AES-256-GCM
# (file extension becomes .db.enc). Keep this passphrase somewhere safe and
# OUTSIDE this repo — without it, encrypted backups are unrecoverable.
# Use scripts/decrypt-backup.js to restore.
BACKUP_PASSPHRASE=
# BACKUP_EMAIL_ENABLED: when true, each daily backup is emailed to ADMIN_EMAIL
# as an attachment (off-site safety net). Files over 20MB are skipped.
BACKUP_EMAIL_ENABLED=false

# Backblaze B2 offsite backup (optional — strongly recommended for production)
# Create a bucket at backblaze.com and generate an application key scoped to it.
# B2_KEY_ID: the application key ID (not the master key ID)
# B2_APPLICATION_KEY: the application key value
# B2_BUCKET_ID: the bucket ID (found in B2 bucket settings)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# Cloudflare (optional — enables analytics + cache purge in admin panel)
# CF_API_TOKEN: create at dash.cloudflare.com/profile/api-tokens → permissions needed:
#   Zone / Analytics / Read  (for analytics)
#   Zone / Cache Purge / Purge  (for the Purge Everything button in Settings)
# CF_ZONE_ID: Cloudflare dashboard → your domain → Overview → Zone ID (right sidebar)
CF_API_TOKEN=
CF_ZONE_ID=

# Google Analytics 4 (optional — enables traffic analytics in admin panel)
# GA4_MEASUREMENT_ID: shown as "G-XXXXXXXXXX" in your GA4 property settings
# GA4_PROPERTY_ID: format is "properties/XXXXXXXXX" (numeric ID, not the G- code)
# GA4_CLIENT_EMAIL + GA4_PRIVATE_KEY: from a Google Cloud service account JSON key
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=properties/XXXXXXXXX
GA4_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
