# Server
PORT=3000
BASE_URL=https://yourdomain.com

# Stripe — get these from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP — works with Gmail app passwords, Postmark, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Who emails come from and where operator notifications go
EMAIL_FROM="Letterhome <hello@yourdomain.com>"
OPERATOR_EMAIL=404officenotfound@gmail.com
